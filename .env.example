# Copy to .env and fill in the deployment from your Microsoft Foundry resource.
# The base URL is the resource host. The app calls {base}/openai/v1/chat/completions.
FOUNDRY_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com
FOUNDRY_API_KEY=
FOUNDRY_MODEL=YOUR-DEPLOYMENT-NAME

# Use omit for reasoning models that reject temperature.
FOUNDRY_TEMPERATURE=0
FOUNDRY_JSON_MODE=on

# Rates for your deployment, in US dollars per million tokens.
# Cost is tokens times these rates, calculated in this app.
FOUNDRY_INPUT_USD_PER_MILLION=0.15
FOUNDRY_OUTPUT_USD_PER_MILLION=0.60
